// optech2: the single player menu as a data page (stock: menu_builtin game).
// Its first lines come from game.lua: the four skills, or with several
// episodes (the re-release data) one line per episode.
{
"banner" "m_banner_game"
}
{
"type" "list"
"source" "first_lines"
}
{
"type" "space"
}
{
"type" "action"
"label" "load game"
"alttext" "$m_load_game"
"command" "menu_loadgame"
}
{
"type" "action"
"label" "save game"
"alttext" "$m_save_game"
"command" "menu_savegame"
}
{
"type" "action"
"label" "credits"
"alttext" "$m_credits"
"command" "menu_credits"
}
{
"type" "action"
"label" "level select"
"command" "menu_levelselect"
"gap" "10"
"if" "levelselect"
}
{
"type" "action"
"label" "mods"
"command" "menu_mods"
"gap" "10"
"if" "mods"
}
