}
{
"type" "bind"
"label" "mouse look"
"command" "+mlook"
"scope" "keyboard"
}
{
"type" "bind"
"label" "keyboard look"
"command" "+klook"
"scope" "keyboard"
}
{
"type" "bind"
"label" "up / jump"
"command" "+moveup"
"scope" "keyboard"
}
{
"type" "bind"
