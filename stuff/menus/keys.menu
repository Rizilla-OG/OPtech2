// optech2: keyboard and mouse bindings (stock: menu_builtin keys).
// Each "bind" shows the keys bound to its command: enter binds, del unbinds.
{
"line" "9"
}
{
"type" "bind"
"label" "attack"
"command" "+attack"
"scope" "keyboard"
}
{
"type" "bind"
"label" "next weapon"
"command" "weapnext"
"scope" "keyboard"
}
{
"type" "bind"
"label" "previous weapon"
"command" "weapprev"
"scope" "keyboard"
}
{
"type" "bind"
"label" "walk forward"
"command" "+forward"
"scope" "keyboard"
}
{
"type" "bind"
"label" "backpedal"
"command" "+back"
"scope" "keyboard"
}
{
"type" "bind"
