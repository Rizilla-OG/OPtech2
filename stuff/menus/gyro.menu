// optech2: the gyro menu as a data page (stock: menu_builtin gyro).
{
"open" "on_open"
}
{
"type" "choice"
"label" "gyro mode"
"cvar" "gyro_mode"
"options" "always off=0;off, button enables=1;on, button disables=2;always on=3"
}
{
"type" "choice"
"label" "gyro space"
"cvar" "gyro_space"
"options" "local=0;player=1;world=2"
"command" "menu_reload"
}
{
"type" "choice"
"label" "local roll"
"cvar" "gyro_local_roll"
"options" "off=0;on=1;on, invert=2"
"if" "lua:local_space"
}
{
"type" "slider"
"label" "yaw sensitivity"
"cvar" "gyro_yawsensitivity"
"min" "0"
"max" "20"
"step" "0.1"
"gap" "10"
"abs" "yes"
}
{
"type" "slider"
"label" "pitch sensitivity"
"cvar" "gyro_pitchsensitivity"
"min" "0"
"max" "20"
"step" "0.1"
"abs" "yes"
}
{
"type" "slider"
"label" "tightening"
"cvar" "gyro_tightening"
"min" "0"
"max" "50"
"step" "0.5"
"gap" "10"
}
{
"type" "slider"
"label" "smoothing"
"cvar" "gyro_smoothing"
"min" "0"
"max" "50"
"step" "0.5"
}
{
"type" "choice"
"label" "acceleration"
"cvar" "gyro_acceleration"
"options" "off=0;on=1"
"command" "menu_reload"
"gap" "10"
}
{
"type" "slider"
"label" "multiplier"
"cvar" "gyro_accel_multiplier"
"min" "1"
"max" "20"
"step" "0.1"
"if" "gyro_acceleration"
}
{
"type" "slider"
"label" "lower thresh"
"cvar" "gyro_accel_lower_thresh"
"min" "0"
"max" "300"
"step" "5"
"format" "%.0f"
"lua" "keep_thresholds"
"if" "gyro_acceleration"
}
{
"type" "slider"
"label" "upper thresh"
"cvar" "gyro_accel_upper_thresh"
"min" "0"
"max" "300"
"step" "5"
"format" "%.0f"
"lua" "keep_thresholds"
"if" "gyro_acceleration"
}
{
"type" "label"
"label" "place the gamepad on a flat,"
"x" "80"
"gap" "10"
}
{
"type" "label"
"label" "stable surface to..."
"x" "80"
}
{
"type" "action"
"label" "calibrate"
"command" "menu_calibrategyro"
"gap" "5"
"align" "right"
}
