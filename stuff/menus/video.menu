// optech2: the video menu as a data page (stock: menu_builtin video). video.lua
// keeps the settings that restart the video (renderer, mode, fullscreen, sync,
// filtering, ui scale) as pending values until "apply"; the rest change at once.
{
"banner" "m_banner_video"
"open" "on_open"
"x" "-8"
}
{
"type" "list"
"source" "renderer"
}
{
"type" "choice"
"label" "video mode"
"alttext" "$m_video_settings"
"cvar" "ui_v_mode"
"options" "[320 240   ]=0;[400 300   ]=1;[512 384   ]=2;[640 400   ]=3;[640 480   ]=4;[800 500   ]=5;[800 600   ]=6;[960 720   ]=7;[1024 480  ]=8;[1024 640  ]=9;[1024 768  ]=10;[1152 768  ]=11;[1152 864  ]=12;[1280 800  ]=13;[1280 720  ]=14;[1280 960  ]=15;[1280 1024 ]=16;[1366 768  ]=17;[1440 900  ]=18;[1600 900  ]=32;[1600 1200 ]=19;[1680 1050 ]=20;[1920 1080 ]=21;[1920 1200 ]=22;[2048 1536 ]=23;[2560 1080 ]=24;[2560 1440 ]=25;[2560 1600 ]=26;[3440 1440 ]=27;[3840 1600 ]=28;[3840 2160 ]=29;[4096 2160 ]=30;[5120 2880 ]=31;[Auto      ]=-2;[Custom    ]=-1"
}
{
"type" "choice"
"label" "max fps"
"cvar" "vid_maxfps"
"options" "30=30;60=60;75=75;120=120;144=144;165=165;240=240;300=300;500=500;1000=1000"
"status" "frames drawn per second at most (vertical sync may hold it lower)"
}
{
"type" "slider"
"label" "brightness"
"alttext" "$m_brightness"
"cvar" "vid_gamma"
"min" "0.1" "max" "2.0" "step" "0.1"
}
{
"type" "slider"
"label" "field of view"
"alttext" "$m_fov"
"cvar" "fov"
"min" "60" "max" "120" "step" "1" "format" "%.0f"
}
{
"type" "list"
"source" "renderer_settings"
}
{
"type" "choice"
"label" "ui scale"
"cvar" "ui_v_uiscale"
"options" "auto=-1;1x=1;2x=2;3x=3;4x=4;5x=5;6x=6;custom=custom"
}
{
"type" "choice"
"label" "fullscreen"
"alttext" "$m_fullscreen"
"cvar" "ui_v_fullscreen"
"options" "no=0;native fullscreen=1;fullscreen window=2"
}
{
"type" "toggle"
"label" "vertical sync"
"alttext" "$m_vsync"
"cvar" "ui_v_vsync"
}
{
"type" "choice"
"label" "aniso filtering"
"cvar" "ui_v_anisotropic"
"options" "off=0;2x=2;4x=4;8x=8;16x=16"
}
{
"type" "choice"
"label" "multisampling"
"cvar" "ui_v_msaa"
"options" "off=0;2x=2;4x=4;8x=8;16x=16"
}
{
"type" "list"
"source" "filter"
}
{
"type" "space"
}
{
"type" "action"
"label" "reset to default"
"command" "menu_reload"
"status" "back to the current settings"
}
{
"type" "action"
"label" "apply"
"alttext" "$m_apply_settings"
"lua" "apply"
}
