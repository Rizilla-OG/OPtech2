#!/bin/sh
# optech2: format the staged changed lines in id style (.clang-format) and re-stage them.
# Only changed lines are touched (git clang-format), so stock id/Yamagi code keeps small diffs.
# Shader sources (*_shaders.c) are GLSL inside C strings and are left alone.
if ! command -v git-clang-format >/dev/null 2>&1; then
	echo "pre-commit: git-clang-format not found" >&2
	exit 1
fi
# The save field table is generated (tools/gen_save_fields.py): checked, never reformatted.
# src/game/rerelease/ holds id's re-release files as released: never reformatted either.
# src/game/lua/ is Lua 5.4 as released by Lua.org: never reformatted.
# src/common/nav/recast/ is Recast/Detour 1.6.0 as released: never reformatted.
if git diff --cached --name-only -- 'src/game/header/*.h' 'src/common/header/shared.h' | grep -q . &&
	command -v python3 >/dev/null 2>&1; then
	if ! python3 -B tools/gen_save_fields.py --check >/dev/null; then
		echo "pre-commit: a saved struct changed; run python3 tools/gen_save_fields.py and stage the table" >&2
		exit 1
	fi
fi
files=$(git diff --cached --name-only --diff-filter=ACM -- 'src/*.c' 'src/*.h' ':!src/client/refresh/*/*_shaders.c' ':!src/game/savegame/tables/savefields.h' ':!src/game/rerelease/*' ':!src/game/lua/*' ':!src/common/nav/recast/*')
[ -z "$files" ] && exit 0
git clang-format --staged --quiet -- $files >/dev/null
echo "$files" | while IFS= read -r f; do
	git add "$f"
done
